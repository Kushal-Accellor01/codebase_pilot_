# Copy to backend/.env and fill in. Never commit .env.

# SQLite database file (relative to the working directory)
CODEBASE_PILOT_DB=codebase_pilot.db
# Where ingestion keeps repository clones and per-run worktrees
CODEBASE_PILOT_WORKSPACE=workspace

# npm registry; point at Artifactory / Azure Artifacts in production
NPM_REGISTRY_URL=
# Bearer token for a private registry (sent only to the NPM_REGISTRY_URL host)
NPM_REGISTRY_TOKEN=

# GitHub token: read access for release notes, write access to the sandbox repo for PRs only
GITHUB_TOKEN=

# Azure OpenAI (Microsoft Foundry): deployment names, not model names
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_STRONG=
AZURE_OPENAI_DEPLOYMENT_FAST=
# Hackathon only; leave empty to use Entra ID (managed identity / az login)
AZURE_OPENAI_API_KEY=
# live | record | replay
LLM_MODE=live

# Comma-separated owner/repo list whose code may be installed and executed
# e.g. Kushal-Accellor01/pilot-sandbox-shop, or the local mirror path from scripts/make_sandbox_mirror.py
EXEC_ALLOWED_REPOS=
# Directory with JSON-lines log files used as production evidence
SEEDED_LOGS_DIR=
# Trigger B: off | comment_only | comment_and_commit
BOT_PR_MODE=comment_only
# Azure Monitor log source (stretch)
AZURE_LOG_ANALYTICS_WORKSPACE_ID=

# Where reports and local PR bodies are written
REPORTS_DIR=reports
# LangGraph checkpoints (separate file so its tables never mix with ours)
CHECKPOINT_DB=checkpoints.db
# Author of commits Pilot makes (local fallback and demo mirror)
PILOT_GIT_AUTHOR=Codebase Pilot <pilot@localhost>
# 1 = run the job worker inside the API process (demo)
PILOT_EMBEDDED_WORKER=
# Approver name shown until SSO exists
PILOT_DEMO_USER=demo
# Optional: require "Authorization: Bearer <token>" on every write endpoint. Give the dashboard the same value
# with VITE_PILOT_API_TOKEN (build time) or localStorage.pilotToken (browser console).
PILOT_API_TOKEN=
# GitHub push webhook secret: POST /api/webhooks/github re-scans the repo on every push to its default branch
GITHUB_WEBHOOK_SECRET=
# Re-scan every known repository every N minutes (embedded worker); 0 = off. Closes finished PRs without a click.
PILOT_RESCAN_MINUTES=0

# Logging: LOG_FORMAT=json for JSON lines
LOG_FORMAT=
